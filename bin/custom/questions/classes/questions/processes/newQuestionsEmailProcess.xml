<?xml version="1.0" encoding="UTF-8"?>
<process xmlns="http://www.hybris.de/xsd/processdefinition"
         start="generateEmail"
         name="newQuestionsEmailProcess"
         processClass="org.training.model.NewQuestionsEmailProcessModel"
         onError="error">

    <action id="generateEmail" bean="generateNewQuestionsEmail">
        <transition name="OK" to="sendEmail"/>
        <transition name="NOK" to="error"/>
    </action>

    <action id="sendEmail" bean="sendEmail">
        <transition name="OK" to="removeSentEmail"/>
        <transition name="NOK" to="failed"/>
    </action>

    <action id="removeSentEmail" bean="removeSentEmail">
        <transition name="OK" to="success"/>
        <transition name="NOK" to="error"/>
    </action>

    <end id="error" state="ERROR">Something went wrong.</end>
    <end id="failed" state="FAILED">Could not send email about new questions.</end>
    <end id="success" state="SUCCEEDED">Sent message about new questions.</end>

</process>