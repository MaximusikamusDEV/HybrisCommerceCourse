$lang = en
$defaultPromoGrp = electronicsPromoGrp

#Promotion 10% sale if cart total > 100$
UPDATE PromotionSourceRule; code[unique = true]                   ; name[lang = $lang]                      ; description[lang = $lang]               ; messageFired[lang = $lang]
                          ; percentageDiscountForCartAbove100Doll ; Percentage discount for Cart above 100$ ; Percentage discount for Cart above 100$ ; 10% discount for cart total above 100$ was used!!!

INSERT_UPDATE PromotionSourceRule; code[unique = true]                   ; priority; maxAllowedRuns; ruleGroup(code)            ; conditions                                                                                                                                      ; actions                                                                                          ; website(Identifier)[default = $defaultPromoGrp]
                                 ; percentageDiscountForCartAbove100Doll ; 0       ; 1             ; customerPromotionRuleGroup ; "[{""parameters"":{""value"":{""value"":{""USD"":100}},""operator"":{""value"":""GREATER_THAN_OR_EQUAL""}},""definitionId"":""y_cart_total""}]" ; "[{""parameters"":{""value"":{""value"":10}},""definitionId"":""y_order_percentage_discount""}]" ;

#Single code coupon for 10$ sale
INSERT_UPDATE SingleCodeCoupon; couponId[unique = true]; maxRedemptionsPerCustomer; maxTotalRedemptions; active[default = true]
                              ; FREE10DOLLGIFT         ; 1                        ; 1000               ;

INSERT_UPDATE PromotionSourceRule; code[unique = true]                ; name[lang = $lang]               ; priority; maxAllowedRuns; ruleGroup(code)          ; conditions                                                                                                    ; actions                                                                                               ; website(Identifier)[default = $defaultPromoGrp]
                                 ; coupon_code_fixed_10_doll_discount ; Free 10$ gift for using a coupon ; 25      ; 1             ; couponPromotionRuleGroup ; "[{""definitionId"":""y_qualifying_coupons"",""parameters"":{""coupons"":{""value"":[""FREE10DOLLGIFT""]}}}]" ; "[{""definitionId"":""y_order_fixed_discount"",""parameters"":{""value"":{""value"":{""USD"":10}}}}]" ;

UPDATE PromotionSourceRule; code[unique = true]                ; name[lang = $lang]                          ; description[lang = $lang]                                                      ; messageFired[lang = $lang]
                          ; coupon_code_fixed_10_doll_discount ; Get 10$ discount on the cart using a coupon ; A percentage discount is added to the cart when a valid coupon code is entered ; You have received 10$ discount on cart using the coupon code FREE10DOLLGIFT